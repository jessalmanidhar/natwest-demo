pipeline{
    agent any

    stages {
        stage ('Checkout code') {
            steps{
                sh '''
                git clone https://github.com/jessalmanidhar/natwest-demo.git
                cd repository
                git checkout main
                '''
            }
        }

        stage ('Run Tests') {
            steps {
                sh'''
                cd repository
                npm install
                npm test
                '''
            }
        }
    }

    post {
        always {
             archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        success {
            echo 'Passed'
        }
        failure {
            echo 'Fai;ed'
        }
    }
}